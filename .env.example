# Copy this file to ".env" (same folder as server.js) and paste your keys.
# Never commit .env or share it.

# Google Gemini (AI rival + art critic). Create the key in a shared TEAM project, not someone's personal one:
# see "Getting a Gemini key that isn't anyone's personal key" in the README. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Each guess and each review is one request. Fewer = the free quota lasts longer.
# GEMINI_GUESSES_PER_TURN=3
# GEMINI_CRITIC=1
# Fake Gemini + ElevenLabs while developing or testing with bots, so you don't spend any quota:
# AI_MOCK=1

# ElevenLabs (game-show announcer voice) — key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
